# Server
PORT=3000
# Origins de CORS permitidos, separados por coma.
# Vacío = permitir todos los origins (app móvil nativa, protegida por rate limit).
# Ejemplo: https://lexlaboral.com.mx,https://localhost:5173,capacitor://localhost
CORS_ORIGINS=

# Gemini
GEMINI_API_KEY=

# Supabase (base de conocimiento RAG)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

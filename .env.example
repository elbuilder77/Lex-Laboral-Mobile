# Supabase Configuration (Required for backend RAG knowledge base)
# Copiar a backend/.env
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY # Secret, solo se usa en el backend

# Gemini API Key (Required for AI, backend)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Frontend Environment Variables (Must start with VITE_)
# En dev apunta al backend local via proxy de Vite (/api -> http://localhost:3000).
# En Android usa la URL pública del backend desplegado, p.ej. https://api.lexlaboral.com/api
VITE_API_URL=/api
VITE_EXPOSE_DEV_SERVER=false
